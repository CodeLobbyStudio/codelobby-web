# Public browser configuration. Never put credentials or JWT secrets here.
# Relative URL uses the Vite development proxy; production needs its own /api proxy.
VITE_API_BASE_URL=/api
# Development only. Keep the /api path when forwarding to Spring Boot.
API_PROXY_TARGET=http://localhost:8080
# Optional local development diagnostics: path to an extracted Eclipse JDT LS.
# JDTLS_HOME=C:/tools/jdtls
# JDTLS_JAVA_HOME=C:/tools/jdk-21
